$TTL 604800
@	IN	SOA	pc11	admin(
				1   ; serial
			   604800   ; refresh
			    86400   ; retry
			  2419200   ; expire
			   604800 ) ; negative cache TTL

; Name servers
@	IN	NS	pc11.ejemplo.com.
	IN	NS	pc12.ejemplo.com.

; RRHH
101	IN	PTR	pc1.ejemplo.com.
102	IN	PTR	pc2.ejemplo.com.

; Admins
103	IN	PTR	pc3.recepcion.ejemplo.com.
104	IN	PTR	pc4.recepcion.ejemplo.com.
105	IN	PTR	pc5.recepcion.ejemplo.com.
106	IN	PTR	pc6.recepcion.ejemplo.com.
107	IN	PTR	pc7.recepcion.ejemplo.com.
108	IN	PTR	pc8.recepcion.ejemplo.com.
109	IN	PTR	pc9.recepcion.ejemplo.com.

; Servers and router

10	IN	PTR	router.ejemplo.com.
11	IN	PTR	pc11.ejemplo.com.
12	IN	PTR	pc12.ejemplo.com.
13	IN	PTR	servidorimpresion.ejemplo.com.
