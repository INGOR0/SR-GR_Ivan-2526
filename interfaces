#Este archivo sirve para configurar las interfaces de red del equipo.

source /etc/network/interfaces.d/*

# The loopback network interface (interfaz que se usa para loopback)
auto lo
iface lo inet loopback

# The primary network interface (interfaz de red primaria o principal)
# Doing exercise 9

auto enp1s0
iface enp1s0 inet dhcp
