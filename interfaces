source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

#Interfaz red 1 NO HAY GATEWAY PORQUE ESTE ES EL ROUTER
auto enp7s0
iface enp7s0 inet static
    address 172.17.4.10
    netmask 255.255.255.0
    up iptables -t nat -A POSTROUTING -o enp1s0 -s 172.17.4.0/24 -j MASQUERADE
    down iptables -t nat -D POSTROUTING -o enp1s0 -s 172.17.4.0/24 -j MASQUERADE

#Interfaz red 2 NO GATEWAY PORQUE ES EL ROUTER
auto enp8s0
iface enp8s0 inet static
    address 172.17.5.10
    netmask 255.255.255.0
    up iptables -t nat -A POSTROUTING -o enp1s0 -s 172.17.5.0/24 -j MASQUERADE
    down iptables -t nat -D POSTROUTING -o enp1s0 -s 172.17.5.0/24 -j MASQUERADE

#Interfaz red 1 NAT 
auto enp1s0
iface enp1s0 inet static
    address 10.0.2.15
    netmask 255.255.255.0
    gateway 10.0.2.1
