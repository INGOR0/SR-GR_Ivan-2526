//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";


// Direct zones

zone "dployerz.com"
{
    type master;
    file "/var/lib/bind/db.dployerz.com";
};

zone "workstation.dployerz.com"
{
    type master;
    file "/var/lib/bind/db.workstation.dployerz.com";	
};

zone "admin.dployerz.com"
{
	type slave;
	file "/var/lib/bind/slave.db.admin.dployerz.com";
	masters { 172.17.5.12; };
};

// Reverse zones

// Network 1: 172.17.4.0/24
zone "4.17.172.in-addr.arpa"
{
	type master;
	file "/var/lib/bind/db.172.17.4.0";
};

// Network 2: 172.17.5.0/24
zone "5.17.172.in-addr.arpa"
{
	type slave;
	file "/var/lib/bind/slave.db.172.17.5.0";
	masters { 172.17.5.12; };
};


