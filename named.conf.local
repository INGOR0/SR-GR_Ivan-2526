//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

// DIRECT ZONE

zone "ejemplo.com"
{
	type slave;
	file "/var/lib/bind/dbesclavo.ejemplo.com";
	masters {172.17.5.11;};
	allow-notify {172.17.5.11;};
};


// Reverse zones

// network 1: 172.17.4.0/24
zone "4.17.172.in-addr.arpa"
{
	type slave;
	file "/var/lib/bind/dbesclavo.172.17.4.0";
	masters {172.17.5.11;};
	allow-notify {172.17.5.11;};
};

// network 2: 172.17.5.0/24
zone "5.17.172.in-addr.arpa"
{
	type slave;
	file "/var/lib/bind/dbesclavo.172.17.5.0";
	masters {172.17.5.11;};
	allow-notify {172.17.5.11;};
};
